# Pantheon Studios local environment template
# Copy this file to .env locally and populate real values.

PANTHEON_SECRET_KEY=replace_me
PANTHEON_API_KEY=replace_me
OPENAI_API_KEY=replace_me
REDDIT_CLIENT_ID=replace_me
REDDIT_CLIENT_SECRET=replace_me
SUBSTACK_TOKEN=replace_me
MEDIUM_INTEGRATION_TOKEN=replace_me

# ---------------------------------------------------------------------------
# SMS / Alert notifications
# ---------------------------------------------------------------------------

# Phone number that receives approval-required alerts (digits, dashes, or E.164 ok)
ALERT_PHONE_NUMBER=260-2442-8050

# --- Option A: Twilio ---
TWILIO_ACCOUNT_SID=replace_me
SMS_AUTH_TOKEN=replace_me
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# --- Option B: SMTP Email-to-SMS gateway (leave blank when using Twilio) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=replace_me
SMTP_PASSWORD=replace_me
# Full carrier gateway address, e.g. 2602442XXXX@tmomail.net
SMS_GATEWAY_ADDRESS=replace_me

# ---------------------------------------------------------------------------
# Web Control Panel Authentication
# ---------------------------------------------------------------------------

# Gradio login credentials for control_panel.py (localhost:7860)
CONTROL_PANEL_USER=admin
CONTROL_PANEL_PASS=pantheon_admin
